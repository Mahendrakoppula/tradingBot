[Unit]
Description=Index-options engine (NIFTY/BANKNIFTY/SENSEX, PAPER mode - full pipeline, simulated fills, no real orders)
After=network-online.target trading-bot-bootstrap.service postgresql.service trading-bot.service
Wants=network-online.target postgresql.service
Requires=trading-bot-bootstrap.service

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/opt/trading-bot/.env
# stagger the two logins on the shared SmartAPI key (2026-09-21: both bots
# logged in at the same instant at boot and the second got a plain-text 403)
ExecStartPre=/bin/sleep 20
ExecStart=/opt/trading-bot/.venv/bin/python -m trading_bot.run_technical
Restart=on-failure
RestartSec=60
# The instance is a t3.small (2 GB) shared with the daily bot and a local
# PostgreSQL: cap this process so a leak can never starve the others.
MemoryMax=600M
# systemd sends SIGTERM on stop (including when EventBridge stops the EC2
# instance) - run_technical.py handles that the same as Ctrl+C (SIGINT).
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
