[Unit]
Description=MCX crude-oil spike (same engine, SHADOW mode, own database - analysis and journaling, zero orders)
After=network-online.target trading-bot-bootstrap.service postgresql.service trading-bot.service trading-bot-technical.service
Wants=network-online.target postgresql.service
Requires=trading-bot-bootstrap.service

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/trading-bot
# secrets + the index engine's settings first, then the MCX overrides (later files win)
EnvironmentFile=/opt/trading-bot/.env
EnvironmentFile=/opt/trading-bot/deploy/mcx.env
# third login on the shared SmartAPI key: stagger behind the daily bot (0 s)
# and the index engine (20 s)
ExecStartPre=/bin/sleep 45
ExecStart=/opt/trading-bot/.venv/bin/python -m trading_bot.run_technical
Restart=on-failure
RestartSec=60
# one underlying, four timeframes: well under the index engine's footprint.
# The box is a t3.micro (1 GB + 1 GB swap) shared with two other bots and
# PostgreSQL - this cap is what keeps the spike from starving the paper run.
MemoryMax=300M
# SIGTERM (systemctl stop, or the 18:00 IST EventBridge instance stop) ends
# the run cleanly with an EOD summary, like Ctrl+C.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
