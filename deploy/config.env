# Non-secret strategy config - committed to the repo on purpose, since none
# of this is sensitive. This is what actually ships in the deploy package;
# real secrets (SMARTAPI_*, TELEGRAM_*, NEWS_API_KEY, FINNHUB_API_KEY) live
# in AWS SSM Parameter Store (/trading-bot/*) and get fetched fresh onto the
# instance on every boot by trading-bot-bootstrap.service - see
# deploy/fetch_secrets.sh. To change strategy behavior in production: edit
# this file, commit on a branch, merge to main - CI deploys it automatically.

# true = log signals only, never call placeOrder/modifyOrder/cancelOrder
DRY_RUN=true

# Second, independent kill switch: even with DRY_RUN=false, no entries happen
# unless this is also explicitly true. Note: this gates ALL entry logic,
# including dry-run signal generation (run_daily.py line ~425) - DRY_RUN=true
# alone is not enough to see simulated trades, this must also be true.
ENABLE_TRADING=true

# Comma-separated underlyings to trade.
WATCHLIST=NIFTY,BANKNIFTY

# This is a DAILY intraday strategy, not near-expiry-only: whether to trade
# today is decided by the direction signal below, not by how close expiry
# is. DTE_MAX just needs to be wide enough to always find an available
# contract (NIFTY has weekly expiries; BANKNIFTY and stock options are
# monthly only, so 45 comfortably covers all of them).
DTE_MIN=0
DTE_MAX=45

# Trading window (24h IST - run_daily.py uses timeutil.now_ist(), not the
# host clock, so this is correct regardless of the instance's system tz).
# ENTRY_TIME=09:15 means from market open - no backtest behind this specific
# value, just widened from 12:30 on request to capture the whole session.
ENTRY_TIME=09:15
EXIT_TIME=15:15

# Short strikes this far OTM (2% = 0.02); hedge wings this much further still.
OTM_DISTANCE_PCT=0.02
WING_DISTANCE_PCT=0.01

# --- capital / paper-trading sizing ---
# Starting paper capital. Only used the very first time the bot runs - after
# that, .state/capital.json tracks the running balance and this is ignored,
# so editing it later won't reset your paper P&L (delete that file to reset).
CAPITAL=50000

# Risk caps as a percentage of the CURRENT capital balance (not the starting
# figure) - they move with the paper P&L. RISK_PER_TRADE_PCT raised from 0.02
# to 0.12 on request, specifically to let today's ~Rs.5,300-5,400/lot
# NIFTY/BANKNIFTY premiums size to >=1 lot (budget must exceed the premium -
# for a long option, max loss on a trade IS the premium paid, so this is also
# effectively the max loss per trade now). NOTE: DAILY_LOSS_CAP_PCT is only
# checked before allowing a NEW entry, not as a forced mid-day exit - since a
# single trade's max loss (12%) now exceeds the daily cap (5%), one full
# losing trade will halt further entries for the rest of the day.
RISK_PER_TRADE_PCT=0.12
DAILY_LOSS_CAP_PCT=0.05

# run_daily.py (ACTIVE - buying, no margin needed): position size is capped
# by budget = min(RISK_PER_TRADE_PCT capital, this fraction of capital),
# divided by the option's actual premium. run_condor.py (DORMANT - selling,
# needs real margin, not viable below roughly Rs.2-3 lakh capital - see
# strategy.py's IronCondorStrategy docstring): this fraction of capital's
# margin per trade. Either way, never more than MAX_LOTS_PER_TRADE lots.
MAX_CAPITAL_PCT_PER_TRADE=0.30
MAX_LOTS_PER_TRADE=5

# --- direction signal for run_daily.py (debit_strategy.py) ---
# Primary: today's OI-buildup category for the underlying (Long/Short Built
# Up, Short Covering, Long Unwinding) - but verified live that this ONLY
# ever covers stock futures, never NIFTY/BANKNIFTY. Fallback (what actually
# drives index entries): simple momentum vs today's open, if it moved at
# least this %.
MOMENTUM_MIN_MOVE_PCT=0.15

# --- pre-market bias (premarket_bias.py) - genuinely LEADING, unlike the
# OI-buildup/momentum signal above which needs today's price to have
# already moved. Gates entries by default - set false for informational only.
PREMARKET_BIAS_GATE_ENABLED=true
US_MOVE_THRESHOLD_PCT=0.5
VIX_CAUTION_LEVEL=20

# --- sector tracking (sector_tracker.py) - 11 NSE sector indices, tracked
# for a periodic Telegram snapshot AND as a trade-direction confirmation
# gate (both, per explicit user choice). Set SECTOR_GATE_ENABLED=false to
# make it informational only.
SECTOR_TRACKING_ENABLED=true
SECTOR_GATE_ENABLED=true
SECTOR_MOVE_THRESHOLD_PCT=0.3
SECTOR_REFRESH_SECONDS=300
SECTOR_NOTIFY_INTERVAL_SECONDS=1800

# --- losing-streak circuit breaker: shrinks size after N losing days,
# does NOT auto-tune entry signals (overfitting risk) - see README.
LOSING_STREAK_COOLDOWN_DAYS=3
LOSING_STREAK_RISK_MULTIPLIER=0.5

# --- liquidity check + depth-aware pricing (liquidity.py): checks the
# specific contract's own OI/depth before entering, prices orders as LIMIT
# off the book instead of an unbounded MARKET order.
MAX_SPREAD_PCT=8.0
MIN_OPEN_INTEREST=100
LIMIT_ORDER_BUFFER_PCT=0.5

# --- daily entry filter for run_condor.py (DORMANT - market_filter.py) ---
# First-cut, unvalidated thresholds - see market_filter.py's docstring.
VIX_MIN=11
VIX_MAX=25
PCR_MIN=0.7
PCR_MAX=1.3

# --- option-chain snapshot logging (option_chain_logger.py) ---
# Pure data collection, never affects trading decisions: SmartAPI has no
# historical data for expired option contracts (see research/README.md), so
# this is the only way to accumulate real premium history for a future
# premium-based backtest. Logs every N seconds during market hours to
# .state/option_chain_log/<UNDERLYING>_<date>.jsonl.
OPTION_CHAIN_LOG_ENABLED=true
OPTION_CHAIN_LOG_INTERVAL_SECONDS=300
OPTION_CHAIN_LOG_STRIKE_BAND_PCT=0.15

# --- candle history logging (candle_history_logger.py) ---
# Real OHLCV+OI candles (not point-sample quotes) at 1/5/10/30-minute and
# daily granularity, for a FIXED small band of near-ATM strikes each day.
# Each interval pulls on its own staggered cadence to stay well within
# getCandleData's rate limits - see candle_history_logger.py's docstring
# for the budget math. Pure data collection, never affects trading.
CANDLE_LOG_ENABLED=true
CANDLE_LOG_STRIKES_EACH_SIDE=2

# --- scalp add-on (scalp_strategy.py) ---
# An ADD-ON alongside the daily strategy above, not a replacement - fully
# independent risk tracking (own daily loss cap) and position state, never
# affects the daily strategy's own behavior. Off by default like every
# other kill switch here - set true deliberately once you want it live.
# Entry: opening-range breakout (09:15-11:15 by default) OR a short-window
# momentum spike, whichever fires first. Exit: unconditional after
# SCALP_MAX_HOLD_MINUTES (true scalp - wins or loses, it closes), with a
# stop-loss backstop if it moves against it hard before then.
SCALP_ENABLED=false
SCALP_RISK_PER_TRADE_PCT=0.01
SCALP_DAILY_LOSS_CAP_PCT=0.03
SCALP_MAX_HOLD_MINUTES=5
SCALP_MAX_TRADES_PER_DAY=3
SCALP_ORB_REF_START=09:15
SCALP_ORB_REF_END=11:15
SCALP_MOMENTUM_WINDOW_MINUTES=5
SCALP_MOMENTUM_MIN_MOVE_PCT=0.1

# =====================================================================
# Second, independent bot (run_technical.py, trading-bot-technical.service)
# - pure technical-indicator strategy (scalp/intraday/swing), own capital
# pool, own kill switches. Shares this SAME .env file (and therefore the
# SmartAPI credentials above) with the daily bot - Angel One issues one
# API key per account, not per app - but everything below is otherwise
# fully independent. See README.md's "Second bot" section and
# .claude/plans/goofy-plotting-sedgewick.md for the full design.
# =====================================================================

# TECH_ENABLE_TRADING flipped true 2026-09-09 after confirming the service
# started cleanly in production (journalctl clean, no crash-loop, logged in
# fine sharing the daily bot's session) - now generating simulated
# (TECH_DRY_RUN=true, no real orders) trades across all 3 tiers. Do not set
# TECH_DRY_RUN=false until there's real paper-trading history to review.
TECH_DRY_RUN=true
TECH_ENABLE_TRADING=true

TECH_CAPITAL=50000
TECH_ENTRY_TIME=09:20
TECH_EXIT_TIME=15:15

# --- shared options-tier sizing/risk (scalp + intraday + index swing) ---
# Raised again 0.20 -> 0.30 2026-09-09 evening (with all three per-tier
# risk pcts below, 0.15 -> 0.30) - user's explicit instruction after
# confirming live that a real intraday NIFTY signal at 14:03-14:07 that day
# got blocked by the prior Rs.7,500 budget too. Effective budget now
# min(risk_pct, this) x capital = Rs.15,000/trade on 50k capital - covers
# all but the very largest premiums seen so far (e.g. the ~Rs.16k+
# BANKNIFTY scalp spike). For a long option, max loss per trade = premium
# paid, so this is ALSO the effective max loss per trade (30% of capital) -
# fine for paper-mode learning, must be revisited before ever setting
# TECH_DRY_RUN=false. History: 0.10 -> 0.20 (same-day fix) -> 0.30 (this).
TECH_MAX_CAPITAL_PCT_PER_TRADE=0.30
TECH_MAX_LOTS_PER_TRADE=1
TECH_MAX_SPREAD_PCT=8.0
TECH_MIN_OPEN_INTEREST=100
TECH_LIMIT_ORDER_BUFFER_PCT=0.5
TECH_DTE_MIN=0
TECH_DTE_MAX=45
TECH_OTM_DISTANCE_PCT=0.01

# --- ATR-based stop/target/trailing-stop (technical_strategy.atr_stop_target)
# - SWING TIER ONLY as of 2026-09-09 evening (scalp/intraday moved to a
# fixed rupee-per-lot stop/target instead, see their own sections below).
# Base multipliers, then scenario-adjusted: STOP widens/tightens with the
# volatility regime, TARGET widens with trend strength. See
# technical_config.py's own comments for the exact formula/bounds.
TECH_ATR_PERIOD=14
TECH_ATR_STOP_MULT=1.5
TECH_ATR_TARGET_MULT=2.5
TECH_ATR_TRAIL_ACTIVATE_MULT=1.0
TECH_ATR_TRAIL_MULT=1.0
TECH_ATR_BASELINE_PERIOD_MULT=3
TECH_ATR_TREND_FAST_PERIOD=9
TECH_ATR_TREND_SLOW_PERIOD=21
TECH_ATR_STOP_SCALE_MIN=0.7
TECH_ATR_STOP_SCALE_MAX=1.5
TECH_ATR_TARGET_SCALE_MIN=1.0
TECH_ATR_TARGET_SCALE_MAX=1.8

# --- scalp tier (1-min, EMA9/21 x VWAP x volume) ---
# Index-only as of 2026-09-09 evening ("lets do only index options").
TECH_SCALP_WATCHLIST=NIFTY,BANKNIFTY,SENSEX
TECH_SCALP_RISK_PER_TRADE_PCT=0.30
TECH_SCALP_DAILY_LOSS_CAP_PCT=0.05
TECH_SCALP_MAX_HOLD_MINUTES=15
TECH_SCALP_MAX_TRADES_PER_DAY=3
# Fixed rupee-per-lot stop/target (NOT ATR-based, see above) - user's
# explicit range was Rs.500-700 stop / Rs.500-800 target; picked midpoints.
TECH_SCALP_STOP_RUPEES_PER_LOT=600.0
TECH_SCALP_TARGET_RUPEES_PER_LOT=700.0

# --- intraday tier (5-min, EMA20/50 or pivot breakout) ---
# Index-only as of 2026-09-09 evening, same reasoning as scalp above.
TECH_INTRADAY_WATCHLIST=NIFTY,BANKNIFTY,SENSEX
TECH_INTRADAY_RISK_PER_TRADE_PCT=0.30
TECH_INTRADAY_DAILY_LOSS_CAP_PCT=0.05
TECH_INTRADAY_MAX_TRADES_PER_DAY=1
TECH_INTRADAY_STOP_RUPEES_PER_LOT=600.0
TECH_INTRADAY_TARGET_RUPEES_PER_LOT=700.0

# --- swing tier (daily, trend-reversal exit) ---
# TECH_SWING_RISK_PER_TRADE_PCT raised alongside the other two tiers,
# 0.15 -> 0.30, 2026-09-09 evening (see TECH_MAX_CAPITAL_PCT_PER_TRADE's
# comment above). For a long option, max loss per trade = premium paid, so
# this is also the effective max loss per trade now (30% of capital) - only
# affects the swing INDEX/options leg, the stock/equity leg sizes off
# TECH_SWING_EQUITY_BUDGET_PCT_PER_TRADE (and the ATR-derived stop
# distance) instead, unaffected by this change.
TECH_SWING_RISK_PER_TRADE_PCT=0.30
TECH_SWING_DAILY_LOSS_CAP_PCT=0.05
# False as of 2026-09-09 evening ("lets do only index options") - gates ONLY
# new swing-equity entries; any equity positions already open when this
# flipped keep being monitored/exited normally, not force-closed.
TECH_SWING_EQUITY_ENABLED=false
TECH_SWING_MIN_VOLUME=500000
TECH_SWING_MAX_HOLD_DAYS=90
TECH_SWING_EQUITY_BUDGET_PCT_PER_TRADE=0.05
TECH_SWING_MAX_EQUITY_POSITIONS=10
TECH_SWING_INDEX_DTE_MIN=20
TECH_SWING_INDEX_DTE_MAX=60
TECH_SWING_WATCHLIST_INDICES=NIFTY,BANKNIFTY,SENSEX

# --- real transaction costs (costs.py), deducted from every realized P&L ---
# Added 2026-09-09 evening ("consider charges as well like gst cgst, stamp
# duty, brokerage charges"). HONESTY CAVEAT: every rate below is a
# first-cut, publicly-known-structure DEFAULT, NOT verified against your
# actual Angel One brokerage plan or today's statutory rates - both change
# periodically. Verify against a real contract note before trusting these
# for anything beyond a rough paper-mode approximation.
TECH_COST_BROKERAGE_PER_ORDER=20.0
TECH_COST_STT_SELL_PCT=0.1
TECH_COST_EXCHANGE_TXN_PCT=0.035
TECH_COST_SEBI_FEE_PCT=0.0001
TECH_COST_STAMP_DUTY_PCT=0.003
TECH_COST_GST_PCT=18.0
TECH_COST_EQUITY_BROKERAGE_PER_ORDER=0.0
TECH_COST_EQUITY_STT_PCT=0.1
TECH_COST_EQUITY_STAMP_DUTY_PCT=0.015
