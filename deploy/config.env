# Non-secret strategy config - committed to the repo on purpose, since none
# of this is sensitive. This is what actually ships in the deploy package;
# real secrets (SMARTAPI_*, TELEGRAM_*, NEWS_API_KEY, FINNHUB_API_KEY) live
# in AWS SSM Parameter Store (/trading-bot/*) and get fetched fresh onto the
# instance on every boot by trading-bot-bootstrap.service - see
# deploy/fetch_secrets.sh. To change strategy behavior in production: edit
# this file, commit on a branch, merge to main - CI deploys it automatically.

# true = log signals only, never call placeOrder/modifyOrder/cancelOrder
DRY_RUN=true

# Second, independent kill switch: even with DRY_RUN=false, no entries happen
# unless this is also explicitly true. Note: this gates ALL entry logic,
# including dry-run signal generation (run_daily.py line ~425) - DRY_RUN=true
# alone is not enough to see simulated trades, this must also be true.
ENABLE_TRADING=true

# Comma-separated underlyings to trade.
WATCHLIST=NIFTY,BANKNIFTY

# This is a DAILY intraday strategy, not near-expiry-only: whether to trade
# today is decided by the direction signal below, not by how close expiry
# is. DTE_MAX just needs to be wide enough to always find an available
# contract (NIFTY has weekly expiries; BANKNIFTY and stock options are
# monthly only, so 45 comfortably covers all of them).
DTE_MIN=0
DTE_MAX=45

# Trading window (24h IST - run_daily.py uses timeutil.now_ist(), not the
# host clock, so this is correct regardless of the instance's system tz).
ENTRY_TIME=12:30
EXIT_TIME=15:15

# Short strikes this far OTM (2% = 0.02); hedge wings this much further still.
OTM_DISTANCE_PCT=0.02
WING_DISTANCE_PCT=0.01

# --- capital / paper-trading sizing ---
# Starting paper capital. Only used the very first time the bot runs - after
# that, .state/capital.json tracks the running balance and this is ignored,
# so editing it later won't reset your paper P&L (delete that file to reset).
CAPITAL=50000

# Risk caps as a percentage of the CURRENT capital balance (not the starting
# figure) - they move with the paper P&L.
RISK_PER_TRADE_PCT=0.02
DAILY_LOSS_CAP_PCT=0.05

# run_daily.py (ACTIVE - buying, no margin needed): position size is capped
# by budget = min(RISK_PER_TRADE_PCT capital, this fraction of capital),
# divided by the option's actual premium. run_condor.py (DORMANT - selling,
# needs real margin, not viable below roughly Rs.2-3 lakh capital - see
# strategy.py's IronCondorStrategy docstring): this fraction of capital's
# margin per trade. Either way, never more than MAX_LOTS_PER_TRADE lots.
MAX_CAPITAL_PCT_PER_TRADE=0.30
MAX_LOTS_PER_TRADE=5

# --- direction signal for run_daily.py (debit_strategy.py) ---
# Primary: today's OI-buildup category for the underlying (Long/Short Built
# Up, Short Covering, Long Unwinding) - but verified live that this ONLY
# ever covers stock futures, never NIFTY/BANKNIFTY. Fallback (what actually
# drives index entries): simple momentum vs today's open, if it moved at
# least this %.
MOMENTUM_MIN_MOVE_PCT=0.15

# --- pre-market bias (premarket_bias.py) - genuinely LEADING, unlike the
# OI-buildup/momentum signal above which needs today's price to have
# already moved. Gates entries by default - set false for informational only.
PREMARKET_BIAS_GATE_ENABLED=true
US_MOVE_THRESHOLD_PCT=0.5
VIX_CAUTION_LEVEL=20

# --- losing-streak circuit breaker: shrinks size after N losing days,
# does NOT auto-tune entry signals (overfitting risk) - see README.
LOSING_STREAK_COOLDOWN_DAYS=3
LOSING_STREAK_RISK_MULTIPLIER=0.5

# --- liquidity check + depth-aware pricing (liquidity.py): checks the
# specific contract's own OI/depth before entering, prices orders as LIMIT
# off the book instead of an unbounded MARKET order.
MAX_SPREAD_PCT=8.0
MIN_OPEN_INTEREST=100
LIMIT_ORDER_BUFFER_PCT=0.5

# --- daily entry filter for run_condor.py (DORMANT - market_filter.py) ---
# First-cut, unvalidated thresholds - see market_filter.py's docstring.
VIX_MIN=11
VIX_MAX=25
PCR_MIN=0.7
PCR_MAX=1.3

# --- option-chain snapshot logging (option_chain_logger.py) ---
# Pure data collection, never affects trading decisions: SmartAPI has no
# historical data for expired option contracts (see research/README.md), so
# this is the only way to accumulate real premium history for a future
# premium-based backtest. Logs every N seconds during market hours to
# .state/option_chain_log/<UNDERLYING>_<date>.jsonl.
OPTION_CHAIN_LOG_ENABLED=true
OPTION_CHAIN_LOG_INTERVAL_SECONDS=300
OPTION_CHAIN_LOG_STRIKE_BAND_PCT=0.15

# --- candle history logging (candle_history_logger.py) ---
# Real OHLCV+OI candles (not point-sample quotes) at 1/5/10/30-minute and
# daily granularity, for a FIXED small band of near-ATM strikes each day.
# Each interval pulls on its own staggered cadence to stay well within
# getCandleData's rate limits - see candle_history_logger.py's docstring
# for the budget math. Pure data collection, never affects trading.
CANDLE_LOG_ENABLED=true
CANDLE_LOG_STRIKES_EACH_SIDE=2

# --- scalp add-on (scalp_strategy.py) ---
# An ADD-ON alongside the daily strategy above, not a replacement - fully
# independent risk tracking (own daily loss cap) and position state, never
# affects the daily strategy's own behavior. Off by default like every
# other kill switch here - set true deliberately once you want it live.
# Entry: opening-range breakout (09:15-11:15 by default) OR a short-window
# momentum spike, whichever fires first. Exit: unconditional after
# SCALP_MAX_HOLD_MINUTES (true scalp - wins or loses, it closes), with a
# stop-loss backstop if it moves against it hard before then.
SCALP_ENABLED=false
SCALP_RISK_PER_TRADE_PCT=0.01
SCALP_DAILY_LOSS_CAP_PCT=0.03
SCALP_MAX_HOLD_MINUTES=5
SCALP_MAX_TRADES_PER_DAY=3
SCALP_ORB_REF_START=09:15
SCALP_ORB_REF_END=11:15
SCALP_MOMENTUM_WINDOW_MINUTES=5
SCALP_MOMENTUM_MIN_MOVE_PCT=0.1
