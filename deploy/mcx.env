# MCX crude-oil spike - SHADOW ONLY (docs/ROADMAP.md "C1"). Overrides layered
# on top of /opt/trading-bot/.env by deploy/trading-bot-mcx.service (systemd
# reads EnvironmentFile= in order, later files win), so secrets and every
# TECH_* setting not repeated here come from the index engine's config.
#
# Everything here is a research setting for a SEPARATE process against a
# SEPARATE database: the index-options PAPER run is untouched. Nothing on
# MCX may leave SHADOW until the index engine has passed its own gates and
# a crude-specific promotion record exists (spec sections 74, 83).
#
# Deployment switch. false = the unit is installed but disabled; true = the
# deploy creates the database and enables the unit (operator decision
# 2026-09-21: collect crude shadow data from 2026-09-22). tests/test_mcx_env_bounds.py
# pins SHADOW mode and the shadow-only invariants regardless of this flag.
TECH_MCX_ENABLED=true

TECH_SESSION=MCX
TECH_MODE=SHADOW
TECH_DRY_RUN=true
TECH_LIVE_TRADING_ENABLED=false
TECH_DATABASE_URL=postgresql:///tradingbot_mcx?host=/var/run/postgresql
# CRUDEOILM (10 bbl, tick Rs.0.05, options expire ~4 sessions before the
# future): the mini is the only crude contract Rs.50k x 0.5% could ever
# size. CRUDEOIL (100 bbl) would be shadow-rejected on every setup.
TECH_UNDERLYINGS=CRUDEOILM
TECH_VOLUME_PROXY=self

# MCX hours 09:00-23:30 IST (23:55 from the first Sunday of November to the
# second Sunday of March, when US markets are on standard time - set
# TECH_SESSION_END=23:55 then). NOTE: the EventBridge schedule stops the EC2
# instance at 18:00 IST, so until that moves the spike only sees the Asian
# and European hours; the US open (17:00-20:00 IST) is where crude trades.
TECH_SESSION_END=23:30
TECH_EOD_CUTOFF=23:00
TECH_EOD_SUMMARY_TIME=23:35

# crude ticks less densely than NIFTY in the Asian hours
TECH_STALE_TICK_SECONDS=60
# monthly options only: the nearest expiry is up to ~30 days out
TECH_OPTION_DTE_MAX=35
# CRUDEOILM option OI is a fraction of index options'
TECH_OPTION_MIN_OI=500
TECH_OPTION_MAX_SPREAD_PCT=4.0
# price reference = near-month future, rolled this many days before its expiry
TECH_FUTURE_ROLL_DAYS=2
TECH_COST_PROFILE=mcx
# MCX holidays differ from NSE's (comma-separated ISO dates, by hand)
TECH_HOLIDAYS=
