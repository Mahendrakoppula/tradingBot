{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadDeployPackage",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__DEPLOY_BUCKET__/trading-bot/*"
    },
    {
      "Sid": "RedeployViaSSM",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:GetCommandInvocation"],
      "Resource": [
        "arn:aws:ssm:__REGION__::document/AWS-RunShellScript",
        "arn:aws:ec2:__REGION__:__AWS_ACCOUNT_ID__:instance/__INSTANCE_ID__"
      ]
    },
    {
      "Sid": "StartStopInstance",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "*"
    }
  ]
}
