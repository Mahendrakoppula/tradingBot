[Unit]
Description=Codex autonomous trading system (Phase 1 health-check skeleton)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingbot
Group=tradingbot
WorkingDirectory=/opt/codex-trading
EnvironmentFile=/opt/codex-trading/.env
ExecStart=/opt/codex-trading/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=60
# systemd sends SIGTERM on stop (including when EventBridge stops the EC2
# instance) - app/main.py's sleep loop exits cleanly on that same as the
# sibling trading_bot services do.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
