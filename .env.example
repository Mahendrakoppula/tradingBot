# Copy to .env and fill in real values. Never commit the real .env.

# --- capital & daily risk policy ---
CAPITAL=50000.0
MAX_DAILY_LOSS=2000.0
PROFIT_PROTECTION_LEVEL=800.0
PROFIT_SELECTIVITY_LEVEL=1000.0

# --- deployment ---
ENVIRONMENT=dry_run
DRY_RUN=true

# --- database ---
DATABASE_URL=postgresql://codex:codex@localhost:5432/codex

# --- Telegram (this bot's own channel - not the `main`-branch bots' channels) ---
CODEX_TELEGRAM_BOT_TOKEN=
CODEX_TELEGRAM_CHAT_ID=

# --- broker (same Angel One SmartAPI account the `main`-branch bots use) ---
SMARTAPI_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=
